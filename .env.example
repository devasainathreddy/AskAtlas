# AskAtlas Environment Variables

# LLM Provider: "groq", "google", "openai", or "ollama"
LLM_PROVIDER=groq

# LLM Model (depends on provider)
# For Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# For Google: gemini-3.8-flash, gemini-3.8-flash-lite, etc.
# For OpenAI: gpt-4o-mini, gpt-4.1-mini, etc.
# For Ollama: Must support tool-calling! e.g., llama3.1, llama3.2, qwen2.5, mistral
LLM_MODEL=llama-3.3-70b-versatile

# Groq API (free API key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API (optional fallback)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API (optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenWeatherMap API (optional - Open-Meteo works automatically without any key)
OPENWEATHERMAP_API_KEY=

# LangSmith (optional - for tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=AskAtlas

# Qdrant (local Docker or Qdrant Cloud instance)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=askatlas_documents

# Application
PDF_PATH=data/rag.pdf
