# AskAtlas Environment Variables

# LLM Provider: "google", "openai", or "ollama"
LLM_PROVIDER=google

# LLM Model (depends on provider)
# For OpenAI: gpt-4o-mini, gpt-4.1-mini, etc.
# For Google: gemini-3.8-flash, gemini-3.8-flash-lite, etc.
# For Ollama: Must support tool-calling! e.g., llama3.1, llama3.2, qwen2.5, mistral
LLM_MODEL=gemini-3.8-flash

# Google Gemini API (required if LLM_PROVIDER=google)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenWeatherMap API (get free key at openweathermap.org)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# LangSmith (optional - for tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=AskAtlas

# Qdrant (local Docker instance)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=askatlas_documents

# Application
PDF_PATH=data/rag.pdf
